---
import { Image } from 'astro:assets';
import type { Project } from '@/data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
const location = project.meta.find((m) => m.label === 'Location')?.value;
const type = project.meta.find((m) => m.label === 'Project Type')?.value;
---
<a href={`${project.categoryPath}${project.slug}/`} class="group block reveal">
  <div class="relative overflow-hidden bg-surface-2 rounded-2xl">
    <div class="aspect-[4/5] overflow-hidden rounded-2xl">
      <Image
        src={project.cover}
        alt={project.alt}
        widths={[400, 700, 1000]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
        class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
      />
    </div>
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
    <span class="absolute left-5 top-5 text-[0.65rem] tracking-[0.2em] uppercase text-cream/90 bg-ink/40 backdrop-blur-sm px-3 py-1.5">{project.categoryLabel}</span>
    <div class="absolute inset-x-0 bottom-0 p-6">
      <h3 class="font-display text-2xl text-cream">{project.name}</h3>
      <p class="mt-1 text-sm text-cream/75">
        {[type, location].filter(Boolean).join(' · ')}
      </p>
      <span class="mt-3 inline-flex items-center gap-2 text-xs tracking-[0.18em] uppercase text-taupe opacity-0 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-400">
        View Project →
      </span>
    </div>
  </div>
</a>
