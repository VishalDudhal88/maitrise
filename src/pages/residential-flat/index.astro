---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { residential } from '@/data/projects';
---
<Base
  title="Residential Flat – Maitrise"
  path="/residential-flat/"
  description="Residential flat interior design projects by Maitrise Associates — bespoke homes across Pune and Sangli."
>
  <section class="container-x pt-8 pb-6">
    <nav class="text-xs tracking-wider uppercase text-muted flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a><span>/</span><span class="text-ink">Residential Flat</span>
    </nav>
  </section>
  <section class="container-x pb-14">
    <span class="eyebrow">Residential</span>
    <h1 class="mt-5 font-display text-5xl md:text-7xl">Residential Flat</h1>
    <p class="mt-6 max-w-2xl text-ink/70">Homes designed around the way our clients live — balancing warmth, function and personalised style.</p>
  </section>
  <section class="container-x pb-24 md:pb-32">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {residential.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
