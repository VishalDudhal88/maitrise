---
import Base from '@/layouts/Base.astro';
---
<Base title="Page Not Found – Maitrise" path="/404/" description="The page you are looking for could not be found.">
  <section class="container-x py-32 md:py-40 text-center">
    <p class="font-display text-7xl md:text-8xl text-taupe">404</p>
    <h1 class="mt-4 text-3xl md:text-4xl">Page not found</h1>
    <p class="mt-4 text-ink/70 max-w-md mx-auto">The page you’re looking for doesn’t exist or may have moved.</p>
    <div class="mt-9 flex flex-wrap gap-4 justify-center">
      <a href="/" class="btn btn-primary">Back Home</a>
      <a href="/projects/" class="btn btn-outline">View Projects</a>
    </div>
  </section>
</Base>
