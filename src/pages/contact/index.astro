---
import Base from '@/layouts/Base.astro';
import { site } from '@/config/site';
const { email, phone, phoneHref, location } = site.contact;
const details = [
  { label: 'Call for Consultation', value: phone, href: `tel:${phoneHref}` },
  { label: 'Drop Us a Line', value: email, href: `mailto:${email}` },
  { label: 'Office Location', value: location, href: undefined },
];
// Map centred on the studio's city (Sangli, Maharashtra).
const mapSrc =
  'https://maps.google.com/maps?q=Maitrise%20Associates%2C%20Sangli%2C%20Maharashtra&z=12&output=embed';
---
<Base
  title="Contact – Maitrise"
  path="/contact/"
  description="Get in touch with Maitrise Associates — call 7709053814, email maitriseassociates@gmail.com. Based in Sangli, Maharashtra."
>
  <section class="container-x pt-6 md:pt-10 pb-24 md:pb-32 grid lg:grid-cols-2 gap-16 items-start">
    <div>
      <span class="eyebrow">Contact Us</span>
      <h1 class="mt-5 font-display text-5xl md:text-7xl">Get in Touch</h1>
      <p class="mt-6 max-w-md text-ink/70">
        Tell us about your space and vision — reach us by phone or email and we’ll start the design conversation.
      </p>
      <dl class="mt-12 space-y-8">
        {details.map((d) => (
          <div class="border-t border-line pt-5">
            <dt class="text-xs tracking-[0.2em] uppercase text-taupe-deep">{d.label}</dt>
            <dd class="mt-2 font-display text-2xl text-ink">
              {d.href ? <a href={d.href} class="hover:text-taupe transition-colors break-all">{d.value}</a> : d.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="reveal overflow-hidden rounded-2xl border border-line shadow-[var(--shadow-soft)]">
      <iframe
        title="Maitrise Associates — Sangli, Maharashtra"
        src={mapSrc}
        width="100%"
        height="520"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>
</Base>
