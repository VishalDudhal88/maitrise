---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Projects grid mirrors the live site: client-named cards with a category
// subheading and the exact thumbnails. Each links to the matching project page.
const thumbs = import.meta.glob<{ default: ImageMetadata }>('@/assets/showcase/*.jpg', { eager: true });
const img = (name: string) => thumbs[`/src/assets/showcase/${name}.jpg`]?.default
  ?? thumbs[`../assets/showcase/${name}.jpg`]?.default;

const showcase = [
  { name: 'Sanket Kothari', category: 'Commercial Space', thumb: 'sanket-kothari', href: '/commercial-space/elegant-workspace/' },
  { name: 'Webster Solutions', category: 'Commercial Space', thumb: 'webster-solutions', href: '/commercial-space/contemporary-workspace/' },
  { name: 'Ullas Nalawade', category: 'Residential Flat', thumb: 'ullas-nalawade', href: '/residential-flat/dreamscape/' },
  { name: 'Suraj Salavi', category: 'Residential Flat', thumb: 'suraj-salavi', href: '/residential-flat/urban-comfort/' },
  { name: 'Sandeep Chavan', category: 'Residential Flat', thumb: 'sandeep-chavan', href: '/residential-flat/modern-warmth/' },
].map((s) => ({ ...s, image: img(s.thumb)! }));
---
<Base
  title="Projects – Maitrise"
  path="/projects/"
  description="Explore Maitrise Associates' portfolio of residential and commercial interior design projects across Pune, Sangli and beyond."
>
  <section class="container-x pt-6 md:pt-10 pb-14">
    <span class="eyebrow">Our Projects</span>
    <h1 class="mt-5 font-display text-5xl md:text-7xl max-w-3xl">Our Projects</h1>
    <p class="mt-6 max-w-2xl text-ink/70">
      Comprehensive design services — planning, styling, and execution — all crafted to elevate your space with
      precision and beauty.
    </p>
  </section>

  <section class="container-x pb-24 md:pb-32">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {showcase.map((p) => (
        <a href={p.href} class="group block reveal">
          <div class="relative overflow-hidden bg-surface-2 rounded-2xl">
            <div class="aspect-[4/5] overflow-hidden rounded-2xl">
              <Image
                src={p.image}
                alt={`${p.name} — ${p.category} by Maitrise Associates`}
                widths={[400, 700, 1000]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
                class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
              />
            </div>
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6 text-center">
              <h3 class="font-display text-2xl text-cream">{p.name}</h3>
              <p class="mt-1 text-sm tracking-wide text-cream/80">{p.category}</p>
              <span class="mt-3 inline-flex items-center gap-2 text-xs tracking-[0.18em] uppercase text-taupe opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-400">
                View Project →
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
