---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
---
<Base
  title="Projects – Maitrise"
  path="/projects/"
  description="Explore Maitrise Associates' portfolio of residential and commercial interior design projects across Pune, Sangli and beyond."
>
  <section class="container-x pt-8 pb-6">
    <nav class="text-xs tracking-wider uppercase text-muted flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a><span>/</span><span class="text-ink">Projects</span>
    </nav>
  </section>
  <section class="container-x pb-14">
    <span class="eyebrow">Our Projects</span>
    <h1 class="mt-5 font-display text-5xl md:text-7xl max-w-3xl">Our Projects</h1>
    <p class="mt-6 max-w-2xl text-ink/70">
      Comprehensive design services — planning, styling, and execution — all crafted to elevate your space with
      precision and beauty.
    </p>
  </section>
  <section class="container-x pb-24 md:pb-32">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
