---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { commercial } from '@/data/projects';
---
<Base
  title="Commercial Space – Maitrise"
  path="/commercial-space/"
  description="Commercial interior design projects by Maitrise Associates — offices and workspaces designed for productivity and well-being."
>
  <section class="container-x pt-8 pb-6">
    <nav class="text-xs tracking-wider uppercase text-muted flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a><span>/</span><span class="text-ink">Commercial Space</span>
    </nav>
  </section>
  <section class="container-x pb-14">
    <span class="eyebrow">Commercial</span>
    <h1 class="mt-5 font-display text-5xl md:text-7xl">Commercial Space</h1>
    <p class="mt-6 max-w-2xl text-ink/70">Workspaces engineered around workflow, functionality and employee well-being — without compromising on elegance.</p>
  </section>
  <section class="container-x pb-24 md:pb-32">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {commercial.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
